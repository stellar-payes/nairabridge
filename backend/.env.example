# Soroban RPC node used for read-only contract calls and event indexing.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Postgres connection string.
DATABASE_URL=postgres://nairabridge:nairabridge@localhost:5432/nairabridge

# Home domains (comma-separated) of the Stellar anchors used for SEP-24
# fiat on/off ramps, e.g. a local NGN anchor and MoneyGram Access.
ANCHOR_HOME_DOMAINS=testanchor.stellar.org

# Contract IDs from `contracts/scripts/deploy.sh` output.
ROUTER_CONTRACT_ID=
FACTORY_CONTRACT_ID=

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
